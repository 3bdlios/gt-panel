      "id": "gt-remote",
      "title": "GT Remote - Mobile web remote",
      "category": "Plugins",
      "version": "1.0.0",
      "description": "All OpenWebif remote buttons in a standalone mobile page on port 8088. Supports iPhone, Android and long press. Open GT Remote on the receiver to see its address and phone pairing code.",
      "warning": "Requires OpenWebif enabled on port 80. Use on your local network. Optional screenshots show menus only. GT Panel restarts the GUI after installation.",
