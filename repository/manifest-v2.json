    {
      "id": "gtcombo-hevc-repair",
      "title": "H.265 channel restart repair",
      "category": "Fixes",
      "version": "1.0.1",
      "description": "Repairs a confirmed HEVC NULL DMA allocation panic. Applies automatically after installation, keeps an original driver backup and restarts the receiver fully once. Restore is available from GT HEVC restart repair in the plugin menu.",
      "warning": "The receiver automatically reboots once after successful application. No reboot on failure. Accepts only the tested GT Combo kernel 5.15.196 HEVC driver. Do not unload the decoder live.",
      "compatibility": {
        "model": [
          "GTMedia GT Combo"
        ],
        "image": [
          "openatv"
        ],
        "version": [
          "8.0.1.20261007"
        ],
