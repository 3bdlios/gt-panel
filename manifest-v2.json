    {
      "id": "gtcombo-android-both",
      "title": "Android restart & boot menu repair",
      "category": "Fixes",
      "version": "1.0.0",
      "description": "Fix both Restart to Android and Android selection in the startup menu for the reviewed GT MEDIA COMBO image. No automatic reboot.",
      "warning": "Installs boot helpers on the USB root. Later, choosing Android explicitly backs up and writes the internal one-shot boot flag. Keep power connected during that write. This combined installer still needs a receiver acceptance test.",
      "compatibility": {
        "model": [
          "GTMedia GT Combo"
        ],
        "image": [
          "openatv"
        ],
        "version": [
          "8.0.1.20261007"
        ],
        "python": [
          "3.14"
        ]
      },
      "url": "https://raw.githubusercontent.com/3bdlios/gt-panel/main/repository/gtcombo-android-fix_1.0.0_all.ipk",
      "checks": [
        {
          "type": "sha256",
          "path": "/dev/bootloader",
          "bytes": 4194304,
          "sha256": "b6f01df81e74a83a52179b7cfdbaf5466833dae47c5b9a8202d9d66861ead36c"
        },
        {
          "type": "uboot_env",
          "path": "/dev/env",
          "bytes": 65536,
          "data_offset": 4,
          "byteorder": "little",
          "values": {
            "bootcmd": "if test ${bootfromnand} = 1; then setenv bootfromnand 0; saveenv; else run bootfromsd; run bootfromusb; run bootfromemmc; fi; run storeboot",
            "bootfromnand": "0"
          }
        }
      ],
