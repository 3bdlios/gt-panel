    {
      "id": "gt-remote",
      "title": "GT Remote - Mobile web remote",
      "category": "Plugins",
      "version": "1.0.1",
      "description": "All OpenWebif remote buttons in a standalone mobile page on port 8088. Opens directly without a pairing code. Supports iPhone, Android and long press. Open GT Remote in the receiver plugin menu to see its address.",
      "warning": "Any device on the same network can use this remote. Requires OpenWebif on port 80. Optional screenshots show menus only. GT Panel restarts the GUI after installation.",
      "compatibility": {
        "model": [
          "GTMedia GT Combo"
        ],
        "image": [
          "openatv"
        ],
        "version": [
          "8.0.1.20261007"
        ],
        "python": [
          "3.14"
        ]
      },
      "url": "https://raw.githubusercontent.com/3bdlios/gt-panel/feature/ipk-one-click/repository/enigma2-plugin-extensions-gtremote_1.0.1_all.ipk",
